{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    // checkJs stays off globally; JS files opt in with a `// @ts-check`
    // pragma. This lets type coverage grow module-by-module instead of
    // pretending the whole codebase is checked (see IMPROVEMENTS.md #21).
    "checkJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.js"],
  "exclude": ["src/__tests__/**"]
}
