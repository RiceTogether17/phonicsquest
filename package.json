{
  "name": "phonicsquest",
  "version": "2.0.0",
  "description": "PhonicsQuest \u2013 production-grade phonics learning adventure for early readers",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 158",
    "typecheck": "tsc --noEmit",
    "check:syntax": "find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "test:e2e": "playwright test",
    "audit:stories": "node scripts/audit-stories.mjs",
    "gen:store-graphics": "node scripts/gen-store-graphics.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks || true"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.2",
    "chart.js": "^4.4.2",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@vitest/ui": "^4.0.18",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jimp": "^1.6.1",
    "jsdom": "^28.1.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "vite": "^5.2.0",
    "vitest": "^4.0.18"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
