{
  "name": "phonicsquest",
  "version": "2.0.0",
  "description": "PhonicsQuest – production-grade phonics learning adventure for early readers",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:syntax": "find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "test:e2e": "playwright test",
    "audit:stories": "node scripts/audit-stories.mjs",
    "gen:store-graphics": "node scripts/gen-store-graphics.mjs",
    "optimize:images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.2",
    "chart.js": "^4.4.2",
    "gsap": "^3.12.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@vitest/ui": "^4.0.18",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jimp": "^1.6.1",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "vite": "^5.2.0",
    "vitest": "^4.0.18"
  }
}
